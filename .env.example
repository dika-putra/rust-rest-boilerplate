# production also sets the Secure flag on the refresh_token cookie, so it needs HTTPS
CARGO_ENV=development

# vars for application instrumentation
ACCESS_TOKEN_SECRET=someSuperDuperAccessSecret123
REFRESH_TOKEN_SECRET=someSuperDuperRefreshSecret123
ARGON_SALT=mySuperSecretSalt123

# embedded SQLite database, the file and its folder are created on first run
DATABASE_URL=sqlite://data/app.db
RUN_MIGRATIONS=true
SEED=true
CORS_ORIGIN=http://localhost:3000
